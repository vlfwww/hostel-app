{
  "ConnectionStrings": {
    "HotelDb": "Data Source=hotel.db"
  },
  "Jwt": {
    "Issuer": "HotelApi",
    "Audience": "HotelApiClient",
    "ExpireMinutes": 120
  },
  "Pagination": {
    "DefaultPageSize": 10,
    "MaxPageSize": 50
  },
  "Cors": {
    "Origins": [ "http://localhost:5080", "https://localhost:7080", "http://localhost:5173", "http://127.0.0.1:5500" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
